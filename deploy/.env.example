# Copy to deploy/.env (ignored by git) and fill in.

# Required. Bearer token the glasses app sends on every API call.
# Generate with: openssl rand -hex 32
# Put the same value in glasses/.env.local as VITE_GATEWAY_TOKEN.
GATEWAY_TOKEN=

# Where Docker publishes the gateway port.
# 127.0.0.1:8080 when nginx runs on the same host (default).
# <LAN address>:8080 when nginx runs on another machine.
GATEWAY_PUBLISH=127.0.0.1:8080

# Origins allowed by CORS. "*" until stage 0 shows which origin the
# Even app WebView sends (see the "origin" field in the gateway log).
GATEWAY_CORS_ORIGINS=*

TZ=Europe/Bucharest
