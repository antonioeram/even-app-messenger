# Copy to deploy/.env (ignored by git) and fill in.

# Required. Bearer token the glasses app sends on every API call.
# Generate with: openssl rand -hex 32
# Put the same value in glasses/.env.local as VITE_GATEWAY_TOKEN.
GATEWAY_TOKEN=

# Image tag and the version reported by /health.
GATEWAY_VERSION=0.6.0

# Where Docker publishes the gateway port.
# 127.0.0.1:8080 when the reverse proxy runs on the same host (default).
# <LAN address>:8080 when it runs on another machine.
GATEWAY_PUBLISH=127.0.0.1:8080

# Origins allowed by CORS. The Even app WebView calls from
# http://127.0.0.1:<port>, and the port changes on every start, so "*" is
# the practical value. Access is protected by the token, not by CORS.
GATEWAY_CORS_ORIGINS=*

# "off" keeps the gateway from connecting to WhatsApp.
GATEWAY_WHATSAPP=on

# Optional: speech-to-text server for voice replies (see contrib/stt-server).
# Leave empty to disable dictation.
GATEWAY_STT_URL=
# Languages you dictate in. When detection picks another language, the
# recording is transcribed again in the first one.
GATEWAY_STT_LANGS=ro,en

# Time zone of the clock shown next to messages.
TZ=Europe/Bucharest
