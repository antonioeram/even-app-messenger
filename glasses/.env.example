# Copy to .env.local (ignored by git) and fill in.

# Origin of your gateway, exactly as the phone reaches it. No trailing path.
# `npm run pack` stamps this origin into the Even Hub network whitelist.
VITE_GATEWAY_URL=https://gateway.example.com

# Must match GATEWAY_TOKEN of the gateway.
# The value is compiled into the bundle and can be read by anyone who has
# the .ehpk file. Keep the package and its beta channel private.
VITE_GATEWAY_TOKEN=
